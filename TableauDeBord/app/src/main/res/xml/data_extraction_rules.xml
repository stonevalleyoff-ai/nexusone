<?xml version="1.0" encoding="utf-8"?>
<!-- Rien n'est sauvegardé dans le cloud Android ni transféré vers un autre appareil :
     la base chiffrée et sa clé restent sur ce téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
